# ===== Bắt buộc =====
# Chuỗi kết nối Postgres của Supabase. Mật khẩu có ký tự đặc biệt (@ : / ? # %) phải URL-encode.
# Truy vấn của app: transaction pooler (cổng 6543)
DATABASE_URL="postgresql://postgres.kmqxdojvbljdnssselxh:1Cookiecat123321!!!@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migration và pg_dump: session pooler (cổng 5432)
DIRECT_URL="postgresql://postgres.kmqxdojvbljdnssselxh:1Cookiecat123321!!!@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# CA của Supabase (Dashboard > Project Settings > Database > SSL Configuration), dán nguyên nội dung file .crt.
DATABASE_CA_CERT="D:/StableDiffusion/AI edu/AI_edu_supabase_fixed/prod-ca-2021.crt"
# Múi giờ dùng để tính "hôm nay" (điểm danh, học phí)
APP_TZ="Asia/Ho_Chi_Minh"
# Chuỗi bí mật ký JWT, production phải dài ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
JWT_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# ===== Khuyến nghị =====
# Mật khẩu ban đầu cho admin và giáo viên (production). Nếu bỏ trống, server sinh ngẫu nhiên và in ra log một lần.
SEED_PASSWORD="1Aoihikatteru!"
# Tên giáo viên trong tài khoản ban đầu (production)
SEED_TEACHER_NAME="miyagitaisuki"
# Domain frontend được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy. Để trống = chỉ cùng nguồn.
CORS_ORIGIN="https://eduscan.example.edu.vn"

# ===== Tùy chọn =====
# Lưu tệp đính kèm bài làm (bucket "homework", private). Lấy trong Supabase > Project Settings > API.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service_role key, chỉ đặt ở server, không đưa vào frontend>"
# Khóa Gemini (chấm bài và sinh nhận xét). Không có thì các tính năng AI trả 503.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Chạy migration khi khởi động (mặc định bật). Đặt false nếu chạy migration riêng bằng npm run db:migrate.
AUTO_MIGRATE="true"
# Đặt false chỉ khi Postgres cục bộ không có SSL
# DATABASE_SSL="false"
PORT=3000
NODE_ENV=production
